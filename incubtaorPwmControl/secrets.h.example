// Copy this file to secrets.h (same folder) and fill in your lab's values.
// secrets.h is git-ignored. These settings are per site, not per incubator:
// every unit in the lab uses the same file and gets its own ID from its MAC address.

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// MQTT broker (Mosquitto on the Raspberry Pi)
#define MQTT_HOST     "192.168.1.10"
#define MQTT_PORT     1883
// Leave MQTT_USER empty if the broker allows anonymous clients
#define MQTT_USER     ""
#define MQTT_PASSWORD ""

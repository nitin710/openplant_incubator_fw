    "id": "op-fn-cmd",
    "type": "function",
    "z": "op-tab",
    "name": "Build cmd topic",
    "func": "// Sends a dashboard control to the selected incubator\nconst id = flow.get('selected');\nif (!id) { node.warn('No incubator selected'); return null; }\nreturn {\n    topic: 'openplant/incubator/' + id + '/cmd/' + msg.topic,\n    payload: String(msg.payload)\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1340,
    "y": 460,
    "wires": [

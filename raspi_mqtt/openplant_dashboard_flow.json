  {
    "id": "op-fn-csv",
    "type": "function",
    "z": "op-tab",
    "name": "CSV line",
    "func": "// One CSV per incubator per day\nconst parts = msg.topic.split('/');\nif (parts[3] !== 'state') return null;\nconst id = parts[2];\nconst s = msg.payload;\nconst ts = new Date().toISOString();\nconst filename = env.get('LOG_DIR') + '/' + id + '_' + ts.slice(0, 10) + '.csv';\nlet line = [ts, s.temp, s.humidity, s.fan1_rpm, s.fan2_rpm, s.light, s.setpoint, s.cooling, s.rssi, s.uptime].join(',') + '\\n';\nif (!fs.existsSync(filename))\n    line = 'timestamp,temp_C,humidity_pct,fan1_rpm,fan2_rpm,light,setpoint_C,cooling,rssi_dBm,uptime_s\\n' + line;\nreturn { filename: filename, payload: line };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [
      {
        "var": "fs",
        "module": "fs"
      }
    ],
    "x": 380,
    "y": 360,

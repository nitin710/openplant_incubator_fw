    "id": "op-fn-select",
    "type": "function",
    "z": "op-tab",
    "name": "Switch device",
    "func": "// Operator picked another incubator: clear the charts and redraw from cache\nflow.set('selected', msg.payload);\nconst dev = (flow.get('devices') || {})[msg.payload];\nif (!dev) return null;\nconst show = ['status', 'meta', 'state']\n    .filter(k => dev[k] !== undefined)\n    .map(k => ({ device: dev.id, topic: k }));\nreturn [show, { payload: [] }];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],

  {
    "id": "op-fn-display",
    "type": "function",
    "z": "op-tab",
    "name": "Render",
    "func": "// Renders the selected incubator from the cache in flow context\nconst STALE_MS = 90 * 1000;  // firmware publishes every 30 s\nconst dev = (flow.get('devices') || {})[msg.device];\nif (!dev) return null;\n\nconst out = new Array(11).fill(null);\n\n// Connection: retained status (LWT) plus our own staleness check\nlet conn;\nif (dev.status === 'offline') conn = '🔴 Offline';\nelse if (dev.lastSeen && Date.now() - dev.lastSeen > STALE_MS)\n    conn = '🟠 No data for ' + Math.round((Date.now() - dev.lastSeen) / 60000) + ' min';\nelse if (dev.status === 'online') conn = '🟢 Online';\nelse conn = '⚪ Unknown';\nout[0] = { payload: conn };\n\nif (msg.topic === 'meta' && dev.meta) {\n    const m = dev.meta;\n    out[1] = { payload: 'FW ' + m.fw + '  ·  ' + m.ip + '  ·  ' + m.mac };\n}\n\nif (msg.topic === 'state' && dev.state) {\n    const s = dev.state;\n    const up = s.uptime || 0;\n    const d = Math.floor(up / 86400), h = Math.floor(up % 86400 / 3600), mi = Math.floor(up % 3600 / 60);\n    const uptime = (d ? d + 'd ' : '') + h + 'h ' + mi + 'm';\n\n    out[2] = { payload: s.temp };\n    out[3] = { payload: s.humidity };\n    out[4] = [{ topic: 'Temperature', payload: s.temp }, { topic: 'Setpoint', payload: s.setpoint }];\n    out[5] = { topic: 'Humidity', payload: s.humidity };\n    out[6] = [{ topic: 'Fan 1', payload: s.fan1_rpm }, { topic: 'Fan 2', payload: s.fan2_rpm }];\n    out[7] = { payload: (s.cooling === 'ON' ? '❄️ Cooling' : '⏸ Idle') + '  ·  setpoint ' + s.setpoint + ' °C  ·  light ' + s.light };\n    out[8] = { payload: s.setpoint };\n    out[9] = { payload: s.light };\n    node.status({ text: s.temp + ' °C, ' + s.cooling + ', RSSI ' + s.rssi + ', up ' + uptime });\n    out[10] = { payload: 'RSSI ' + s.rssi + ' dBm  ·  up ' + uptime };\n}\nreturn out;",
    "outputs": 11,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 860,
    "y": 200,
    "wires": [

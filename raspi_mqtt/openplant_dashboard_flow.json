    "id": "op-fn-tick",
    "type": "function",
    "z": "op-tab",
    "name": "Stale check",
    "func": "const id = flow.get('selected');\nreturn id ? { device: id, topic: 'tick' } : null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",

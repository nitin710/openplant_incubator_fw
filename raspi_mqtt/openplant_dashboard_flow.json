  {
    "id": "op-fn-registry",
    "type": "function",
    "z": "op-tab",
    "name": "Track devices",
    "func": "// Topic: openplant/incubator/<id>/<status|meta|state>\nconst parts = msg.topic.split('/');\nconst id = parts[2];\nconst kind = parts[3];\nif (!id || !['status', 'meta', 'state'].includes(kind)) return null;\n\nconst devices = flow.get('devices') || {};\nconst isNew = !devices[id];\nconst dev = devices[id] || (devices[id] = { id: id });\n\nif (kind === 'status') dev.status = String(msg.payload);\nelse if (kind === 'meta') dev.meta = msg.payload;\nelse { dev.state = msg.payload; dev.lastSeen = Date.now(); }\nflow.set('devices', devices);\n\nlet selected = flow.get('selected');\nlet menu = null;\nif (isNew) {\n    if (!selected) { selected = id; flow.set('selected', id); }\n    menu = {\n        options: Object.keys(devices).sort().map(d => ({ label: d, value: d })),\n        payload: selected\n    };\n}\nconst show = id === selected ? { device: id, topic: kind } : null;\nreturn [menu, show];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
    "y": 120,
    "wires": [
      [
        "op-dd-device"
      ],
      [
        "op-fn-display"
      ]
    ]
  },
